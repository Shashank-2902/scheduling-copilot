# Copy this file to .env and fill it in. .env is never committed.
POSTGRES_USER=sched
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sched

# Needed only for /ask and for the LLM column of the evals. The tests do not need it.
# Get a free key in the Groq console (console.groq.com) and check the current model names there.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Demo mode without any model: set LLM_BACKEND=regex. Only simple, regular questions are understood.
LLM_BACKEND=

# Optional local fallback, for example http://host.docker.internal:11434 when the API runs in Docker.
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b
